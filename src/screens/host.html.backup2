<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Voxly - Gerencia</title>
<style>
  :root {
    --bg:       #0d0d1a;
    --surface:  #1a1a2e;
    --surface2: #16213e;
    --accent:   #e040fb;
    --accent2:  #7c4dff;
    --danger:   #ff1744;
    --warn:     #ff9100;
    --ok:       #00e676;
    --text:     #e8e8ff;
    --muted:    #7a7a9d;
    --radius:   10px;
    --font:     'Segoe UI', system-ui, sans-serif;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: var(--font); height: 100vh; display: flex; flex-direction: column; overflow: hidden; }

  /* -- HEADER ----------------------------------- */
  header {
    background: var(--surface2);
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #ffffff18;
  }
  header h1 { font-size: 1.2rem; letter-spacing: 2px; color: var(--accent); text-transform: uppercase; }
  .header-controls { display: flex; gap: 10px; align-items: center; }

  /* -- LAYOUT ------------------------------------ */
  .layout { display: grid; grid-template-columns: 340px 1fr 320px; gap: 0; flex: 1; overflow: hidden; }

  .panel {
    background: var(--surface);
    border-right: 1px solid #ffffff10;
    display: flex; flex-direction: column;
    overflow: hidden;
  }
  .panel:last-child { border-right: none; }
  .panel-header {
    padding: 14px 16px;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--muted);
    text-transform: uppercase;
    border-bottom: 1px solid #ffffff10;
    flex-shrink: 0;
  }
  .panel-body { flex: 1; overflow-y: auto; padding: 12px; }
  .panel-body::-webkit-scrollbar { width: 4px; }
  .panel-body::-webkit-scrollbar-thumb { background: #ffffff20; border-radius: 2px; }

  /* -- FILA -------------------------------------- */
  .queue-item {
    background: var(--surface2);
    border: 1px solid #ffffff12;
    border-radius: var(--radius);
    padding: 12px 14px;
    margin-bottom: 8px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    position: relative;
    cursor: default;
    transition: border-color .2s;
  }
  .queue-item:hover { border-color: var(--accent2); }
  .queue-item.playing { border-color: var(--ok); background: #00e67610; }
  .queue-item.missing { border-color: var(--danger); background: #ff174410; }
  .queue-item.duet { border-color: var(--warn); }

  .queue-pos {
    min-width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--accent2);
    color: #fff;
    font-size: .8rem;
    font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .queue-item.playing .queue-pos { background: var(--ok); color: #000; }
  .queue-item.missing .queue-pos { background: var(--danger); }

  .queue-info { flex: 1; }
  .queue-song { font-size: .95rem; font-weight: 600; margin-bottom: 2px; }
  .queue-artist { font-size: .8rem; color: var(--muted); }
  .queue-singer { font-size: .78rem; color: var(--accent); margin-top: 4px; }
  .queue-badge {
    font-size: .65rem; font-weight: 700; letter-spacing: 1px;
    padding: 2px 7px; border-radius: 99px;
    background: var(--danger); color: #fff;
    position: absolute; top: 8px; right: 8px;
  }
  .queue-badge.duet { background: var(--warn); color: #000; }
  .queue-badge.playing { background: var(--ok); color: #000; }

  .queue-actions { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }

  /* -- CENTRO - PLAYER CONTROLS ------------------ */
  .center-panel { border-right: 1px solid #ffffff10; }
  .now-playing {
    margin: 16px;
    background: var(--surface2);
    border-radius: var(--radius);
    padding: 20px;
    border: 1px solid var(--ok);
  }
  .np-label { font-size: .7rem; letter-spacing: 1.5px; color: var(--ok); text-transform: uppercase; margin-bottom: 8px; }
  .np-song { font-size: 1.4rem; font-weight: 700; }
  .np-artist { color: var(--muted); font-size: .9rem; margin-top: 4px; }
  .np-singer { color: var(--accent); font-size: .85rem; margin-top: 6px; }

  .player-controls {
    display: flex; gap: 12px; align-items: center;
    margin: 0 16px 16px;
    flex-wrap: wrap;
  }

  /* -- REGRAS / CONFIG ---------------------------- */
  .rules-section { padding: 16px; }
  .rules-section h3 { font-size: .75rem; color: var(--muted); letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 12px; }
  .rule-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; font-size: .88rem; }
  .rule-row label { color: var(--text); }
  .rule-input {
    width: 60px; padding: 4px 8px;
    background: var(--surface2); border: 1px solid #ffffff20;
    border-radius: 6px; color: var(--text); text-align: center; font-size: .9rem;
  }

  /* -- BUTTONS ----------------------------------- */
  .btn {
    padding: 8px 16px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-size: .82rem;
    font-weight: 600;
    letter-spacing: .5px;
    transition: opacity .15s, transform .1s;
  }
  .btn:active { transform: scale(.97); }
  .btn:hover { opacity: .85; }
  .btn-primary   { background: var(--accent); color: #fff; }
  .btn-secondary { background: var(--accent2); color: #fff; }
  .btn-ok        { background: var(--ok); color: #000; }
  .btn-danger    { background: var(--danger); color: #fff; }
  .btn-ghost     { background: transparent; border: 1px solid #ffffff25; color: var(--text); }
  .btn-warn      { background: var(--warn); color: #000; }
  .btn-sm        { padding: 4px 10px; font-size: .75rem; border-radius: 6px; }

  /* -- QR CODE ------------------------------------ */
  .qr-container { text-align: center; padding: 16px; }
  #qr-canvas { border-radius: 10px; background: #fff; padding: 8px; }
  .qr-url { font-size: .7rem; color: var(--muted); margin-top: 8px; word-break: break-all; }

  /* -- USERS LIST --------------------------------- */
  .user-item {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 10px; border-radius: 8px;
    margin-bottom: 6px;
    background: var(--surface2);
  }
  .user-avatar {
    width: 34px; height: 34px; border-radius: 50%;
    object-fit: cover; background: var(--accent2);
    flex-shrink: 0;
  }
  .user-name { font-size: .88rem; font-weight: 500; }
  .user-status { font-size: .72rem; color: var(--muted); }
  .user-badge { margin-left: auto; }

  /* -- MISC -------------------------------------- */
  .empty { color: var(--muted); font-size: .85rem; text-align: center; padding: 30px 0; }
  .tag { font-size: .65rem; padding: 2px 6px; border-radius: 4px; font-weight: 700; }
  .tag-online { background: #00e67620; color: var(--ok); }
  .tag-busy   { background: #ff910020; color: var(--warn); }

  .folder-row {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 16px;
    background: var(--surface2);
    border-bottom: 1px solid #ffffff10;
    font-size: .8rem;
  }
  .folder-path { flex: 1; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .cycle-bar {
    padding: 8px 16px;
    background: var(--surface2);
    border-bottom: 1px solid #ffffff10;
    display: flex; align-items: center; gap: 12px; font-size: .82rem;
  }
  .cycle-num { font-size: 1.1rem; font-weight: 700; color: var(--accent); }

  input[type=number]::-webkit-inner-spin-button { opacity: 1; }
</style>
</head>
<body>

<header>
  <h1>? Voxly</h1>
  <div class="header-controls">
    <span id="cycle-label" style="font-size:.8rem;color:var(--muted)">Ciclo <strong id="cycle-num" style="color:var(--accent)">1</strong></span>
    <button class="btn btn-secondary btn-sm" onclick="nextCycle()">Proximo Ciclo</button>
    <button class="btn btn-ghost btn-sm" onclick="openSettings()">? Config</button>
  </div>
</header>

<div class="layout">

  <!-- -- PAINEL ESQUERDO: FILA -------------------- -->
  <div class="panel">
    <div class="panel-header">Fila de Musicas</div>
    <div class="folder-row">
      <span class="folder-path" id="folder-path-display">Nenhuma pasta selecionada</span>
      <button class="btn btn-ghost btn-sm" onclick="selectFolder()">? Pasta</button>
    </div>
    <div class="panel-body" id="queue-list">
      <div class="empty">A fila esta vazia.<br>Aguarde solicitacoes.</div>
    </div>
  </div>

  <!-- -- PAINEL CENTRAL: CONTROLES --------------- -->
  <div class="panel center-panel">
    <div class="panel-header">Controle do Palco</div>
    <div class="panel-body">

      <div class="now-playing" id="now-playing-box">
        <div class="np-label">> Tocando agora</div>
        <div class="np-song" id="np-song">-</div>
        <div class="np-artist" id="np-artist">-</div>
        <div class="np-singer" id="np-singer">-</div>
      </div>

      <div class="player-controls">
        <button class="btn btn-ok"      onclick="playerCmd('play')">> Play</button>
        <button class="btn btn-warn"    onclick="playerCmd('pause')">|| Pausa</button>
        <button class="btn btn-danger"  onclick="skipSong()">>> Pular</button>
        <button class="btn btn-ghost"   onclick="playerCmd('fullscreen')">? Fullscreen</button>
      </div>

      <!-- QR CODE -->
      <div class="qr-container">
        <div class="panel-header" style="margin-bottom:12px">QR Code - Acesso dos Cantores</div>
        <canvas id="qr-canvas" width="180" height="180"></canvas>
        <div class="qr-url" id="qr-url-display">-</div>
        <div style="display:flex;gap:8px;justify-content:center;margin-top:10px">
          <input id="webapp-url-input" type="text" placeholder="https://seu-app.web.app"
            style="flex:1;padding:6px 10px;background:var(--surface2);border:1px solid #ffffff20;border-radius:6px;color:var(--text);font-size:.8rem" />
          <button class="btn btn-primary btn-sm" onclick="saveWebUrl()">Salvar</button>
        </div>
      </div>

      <!-- REGRAS DO HOST -->
      <div class="rules-section">
        <h3>Regras do Ciclo</h3>
        <div class="rule-row">
          <label>Musicas por ciclo (solicitacao)</label>
          <input class="rule-input" type="number" id="rule-songs-per-cycle" value="1" min="1" max="10" onchange="saveRules()" />
        </div>
        <div class="rule-row">
          <label>Participacoes em dueto por ciclo</label>
          <input class="rule-input" type="number" id="rule-duets-per-cycle" value="1" min="0" max="10" onchange="saveRules()" />
        </div>
        <div class="rule-row">
          <label>Max. cantores na fila simultaneamente</label>
          <input class="rule-input" type="number" id="rule-max-queue" value="20" min="1" max="99" onchange="saveRules()" />
        </div>
      </div>

    </div>
  </div>

  <!-- -- PAINEL DIREITO: CANTORES ----------------- -->
  <div class="panel">
    <div class="panel-header">Cantores Presentes</div>
    <div class="panel-body" id="users-list">
      <div class="empty">Nenhum cantor conectado ainda.</div>
    </div>
  </div>

</div>

<!-- ============================================ -->
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import {
  getFirestore, collection, onSnapshot, doc, updateDoc, deleteDoc, orderBy, query, serverTimestamp, getDoc, writeBatch
} from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

// -- SUBSTITUA AQUI COM SEU firebaseConfig ----------------------------------
const firebaseConfig = {
  apiKey:            "COLOQUE_AQUI",
  authDomain:        "COLOQUE_AQUI",
  projectId:         "COLOQUE_AQUI",
  storageBucket:     "COLOQUE_AQUI",
  messagingSenderId: "COLOQUE_AQUI",
  appId:             "COLOQUE_AQUI",
};
// ---------------------------------------------------------------------------

const firebaseApp = initializeApp(firebaseConfig);
const db = getFirestore(firebaseApp);

// -- Estado local ------------------------------------------------------------
let queueData   = [];
let usersData   = [];
let currentSong = null;
let cycleNumber = parseInt(localStorage.getItem("cycleNumber") || "1");
let rules       = JSON.parse(localStorage.getItem("rules") || '{"songsPerCycle":1,"duetsPerCycle":1,"maxQueue":20}');

document.getElementById("cycle-num").textContent = cycleNumber;
document.getElementById("rule-songs-per-cycle").value  = rules.songsPerCycle;
document.getElementById("rule-duets-per-cycle").value  = rules.duetsPerCycle;
document.getElementById("rule-max-queue").value        = rules.maxQueue;

// -- QR Code -----------------------------------------------------------------
async function loadQrCode() {
  const QRCode = (await import("https://cdn.jsdelivr.net/npm/qrcode@1.5.3/+esm")).default;
  const url = await window.electronAPI.getWebAppUrl();
  if (url) {
    document.getElementById("webapp-url-input").value = url;
    document.getElementById("qr-url-display").textContent = url;
    QRCode.toCanvas(document.getElementById("qr-canvas"), url, { width: 180, margin: 1 });
  }
}
loadQrCode();

window.saveWebUrl = async function() {
  const url = document.getElementById("webapp-url-input").value.trim();
  if (!url) return;
  await window.electronAPI.setWebAppUrl(url);
  document.getElementById("qr-url-display").textContent = url;
  const QRCode = (await import("https://cdn.jsdelivr.net/npm/qrcode@1.5.3/+esm")).default;
  QRCode.toCanvas(document.getElementById("qr-canvas"), url, { width: 180, margin: 1 });
};

// -- Pasta de musicas ---------------------------------------------------------
async function initFolder() {
  const f = await window.electronAPI.getMusicFolder();
  if (f) document.getElementById("folder-path-display").textContent = f;
}
initFolder();

window.selectFolder = async function() {
  const f = await window.electronAPI.selectMusicFolder();
  if (f) {
    document.getElementById("folder-path-display").textContent = f;
    await refreshQueueFiles();
  }
};

window.electronAPI.onMusicFolderChanged(() => refreshQueueFiles());

async function refreshQueueFiles() {
  const links = await window.electronAPI.getMusicLinks();
  for (const item of queueData) {
    if (links[item.id]) {
      item._resolvedFile = links[item.id];
      item._missing = false;
    } else {
      const fp = await window.electronAPI.resolveMusicFile(item.song, item.artist);
      item._resolvedFile = fp;
      item._missing = !fp;
    }
  }
  renderQueue();
}

// -- Firestore: fila em tempo real -------------------------------------------
onSnapshot(
  query(collection(db, "queue"), orderBy("requestedAt", "asc")),
  async (snap) => {
    const links = await window.electronAPI.getMusicLinks();
    queueData = await Promise.all(snap.docs.map(async d => {
      const data = { id: d.id, ...d.data() };
      if (links[d.id]) {
        data._resolvedFile = links[d.id];
        data._missing = false;
      } else {
        const fp = await window.electronAPI.resolveMusicFile(data.song, data.artist);
        data._resolvedFile = fp;
        data._missing = !fp;
      }
      return data;
    }));
    renderQueue();
  }
);

// -- Firestore: usuarios em tempo real ---------------------------------------
onSnapshot(collection(db, "users"), snap => {
  usersData = snap.docs.map(d => ({ id: d.id, ...d.data() }));
  renderUsers();
});

// -- Render fila --------------------------------------------------------------
function renderQueue() {
  const el = document.getElementById("queue-list");
  if (!queueData.length) { el.innerHTML = '<div class="empty">A fila esta vazia.<br>Aguarde solicitacoes.</div>'; return; }
  el.innerHTML = queueData.map((item, i) => {
    const isPlaying = currentSong?.id === item.id;
    const isMissing = item._missing;
    const isDuet    = item.duetWith?.length > 0;
    let cls = "queue-item";
    if (isPlaying) cls += " playing";
    if (isMissing) cls += " missing";
    if (isDuet)    cls += " duet";

    let badge = "";
    if (isPlaying) badge = '<span class="queue-badge playing">TOCANDO</span>';
    else if (isMissing) badge = '<span class="queue-badge">SEM ARQUIVO</span>';
    else if (isDuet)    badge = '<span class="queue-badge duet">DUETO</span>';

    const duetNames = isDuet ? `<div style="font-size:.72rem;color:var(--warn);margin-top:2px">? Dueto: ${item.duetWith.join(", ")}</div>` : "";

    const actions = isMissing
      ? `<button class="btn btn-warn btn-sm" onclick="linkFile('${item.id}')">? Vincular Arquivo</button>`
      : "";

    const playBtn = (!isPlaying && !isMissing)
      ? `<button class="btn btn-ok btn-sm" onclick="playSong('${item.id}')">> Tocar</button>` : "";

    const removeBtn = `<button class="btn btn-danger btn-sm" onclick="removeSong('${item.id}')">? Remover</button>`;

    return `<div class="${cls}">
      <div class="queue-pos">${i + 1}</div>
      <div class="queue-info">
        <div class="queue-song">${escHtml(item.song)}</div>
        <div class="queue-artist">${escHtml(item.artist)}</div>
        <div class="queue-singer">? ${escHtml(item.singerName || "-")}</div>
        ${duetNames}
        <div class="queue-actions">${playBtn}${actions}${removeBtn}</div>
      </div>
      ${badge}
    </div>`;
  }).join("");
}

// -- Render cantores ----------------------------------------------------------
function renderUsers() {
  const el = document.getElementById("users-list");
  if (!usersData.length) { el.innerHTML = '<div class="empty">Nenhum cantor conectado ainda.</div>'; return; }
  el.innerHTML = usersData.map(u => {
    const hasSung   = (u.songsThisCycle || 0) >= (rules.songsPerCycle);
    const hasDueted = (u.duetsThisCycle || 0) >= (rules.duetsPerCycle);
    const statusCls = hasSung ? "user-status" : "user-status";
    const tagCls    = hasSung ? "tag tag-busy" : "tag tag-online";
    const tagLabel  = hasSung ? "Aguardando" : "Pode cantar";
    return `<div class="user-item">
      <img class="user-avatar" src="${u.photoURL || 'data:image/svg+xml,<svg xmlns=\\\\'http://www.w3.org/2000/svg\\\\'><rect width=\\\\'34\\\\' height=\\\\'34\\\\' fill=\\\\'%237c4dff\\\\'/></svg>'}" />
      <div>
        <div class="user-name">${escHtml(u.displayName || u.email)}</div>
        <div class="user-status">? ${u.songsThisCycle || 0}/${rules.songsPerCycle} &nbsp;? ${u.duetsThisCycle || 0}/${rules.duetsPerCycle}</div>
      </div>
      <span class="${tagCls} user-badge">${tagLabel}</span>
    </div>`;
  }).join("");
}

// -- Acoes --------------------------------------------------------------------
window.playSong = async function(id) {
  const item = queueData.find(q => q.id === id);
  if (!item || !item._resolvedFile) return;
  currentSong = item;
  await window.electronAPI.playSong(item._resolvedFile);
  document.getElementById("np-song").textContent   = item.song;
  document.getElementById("np-artist").textContent = item.artist;
  document.getElementById("np-singer").textContent = item.singerName || "-";
  await updateDoc(doc(db, "queue", id), { status: "playing" });
  renderQueue();
};

window.skipSong = async function() {
  if (!currentSong) return;
  const id = currentSong.id;
  // Incrementa contador do cantor
  await updateDoc(doc(db, "users", currentSong.userId), {
    songsThisCycle: (currentSong._singerSongsCount || 0) + 1
  });
  // Remove da fila
  await deleteDoc(doc(db, "queue", id));
  currentSong = null;
  document.getElementById("np-song").textContent   = "-";
  document.getElementById("np-artist").textContent = "-";
  document.getElementById("np-singer").textContent = "-";
  window.electronAPI.playerCommand("stop");
};

window.removeSong = async function(id) {
  if (!confirm("Remover essa musica da fila?")) return;
  await deleteDoc(doc(db, "queue", id));
};

window.linkFile = async function(id) {
  const fp = await window.electronAPI.linkMusicFile(id);
  if (fp) await refreshQueueFiles();
};

window.playerCmd = function(cmd) {
  window.electronAPI.playerCommand(cmd);
};

window.nextCycle = async function() {
  if (!confirm("Avancar para o proximo ciclo? Isso vai resetar os contadores de todos os cantores.")) return;
  cycleNumber++;
  localStorage.setItem("cycleNumber", cycleNumber);
  document.getElementById("cycle-num").textContent = cycleNumber;
  const batch = writeBatch(db);
  usersData.forEach(u => {
    batch.update(doc(db, "users", u.id), { songsThisCycle: 0, duetsThisCycle: 0 });
  });
  await batch.commit();
};

window.saveRules = function() {
  rules = {
    songsPerCycle:  parseInt(document.getElementById("rule-songs-per-cycle").value),
    duetsPerCycle:  parseInt(document.getElementById("rule-duets-per-cycle").value),
    maxQueue:       parseInt(document.getElementById("rule-max-queue").value),
  };
  localStorage.setItem("rules", JSON.stringify(rules));
  renderUsers();
};

window.openSettings = function() { alert("Settings - em breve"); };

function escHtml(s) {
  if (!s) return "";
  return s.replace(/&/g,"&").replace(/</g,"<").replace(/>/g,">").replace(/"/g,""");
}
</script>
</body>
</html>