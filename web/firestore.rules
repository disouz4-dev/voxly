rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Antes a regra era "quem estiver logado pode tudo". A Gerencia entra com
    // login anonimo (automatico, invisivel), e login anonimo qualquer pessoa do
    // mundo consegue fazer: na pratica, qualquer um apagava a fila e a sessao
    // de qualquer casa. Foi o que a revisao de seguranca de 11/09/2026 mostrou.
    //
    // A regra agora nao pergunta QUEM e voce — nada de conta, nada de senha,
    // nada de passo a mais no computador do KJ. Ela pergunta de quem e a
    // SESSAO: quem abre carimba a sessao como dona (donoUid), e so a dona
    // manda nela. O cantor mexe nos proprios pedidos. Estranho nao encosta.

    function logado()  { return request.auth != null; }
    function eu()      { return request.auth.uid; }

    function dadosDaSessao(sid) {
      return get(/databases/$(database)/documents/sessoes/$(sid)).data;
    }
    function souDono(sid) {
      return logado() && dadosDaSessao(sid).donoUid == eu();
    }

    // Sessao abandonada: a Gerencia dona marca presenca a cada minuto
    // (hostVivoEm). Dez minutos sem marcar = Voxly fechado ou caido, e dai
    // qualquer Gerencia pode derrubar — e o caso real de "sessao presa em outra
    // maquina". Enquanto a dona esta viva, ninguem de fora a derruba.
    function abandonada(d) {
      return !('hostVivoEm' in d) || d.hostVivoEm < request.time - duration.value(10, 'm');
    }
    // Sessao antiga, de antes do carimbo de dono: continua administravel.
    function semDono(d) { return !('donoUid' in d); }

    // Entrada paga: desligada, todo mundo pede. Ligada, so quem a Gerencia dona
    // marcou como pago (entrada.js). O cantor nao consegue se marcar.
    function entradaPaga(sid) {
      let cobranca = dadosDaSessao(sid).get('cobranca', {});
      let pagamento = /databases/$(database)/documents/sessoes/$(sid)/pagamentos/$(eu());
      return cobranca.get('ativa', false) != true
          || (exists(pagamento) && get(pagamento).data.status == 'pago');
    }

    // Ver o que esta DENTRO da sessao (fila, presencas, convites...). Com
    // ingresso ligado, quem nao pagou nao acessa: so ve o documento da sessao,
    // que traz o preco e o QR. A Gerencia dona ve tudo; sessao abandonada
    // tambem abre, para a faxina de outra maquina guardar o relatorio.
    function aceitaDueto(uid) {
      let perfil = /databases/$(database)/documents/cantores/$(uid);
      return !exists(perfil) || get(perfil).data.get('aceitaDueto', true) != false;
    }

    // Hora de fechar a fila (show de 17/09: gente pedindo musica depois do
    // limite). O app ja bloqueia; aqui e a defesa para app velho ou pedido
    // forjado. Mesma folga de 5 min do sessao-regras.js. O KJ estica a noite
    // pelo +30 min, que so move este horario; sessao antiga sem termino ou
    // com outro formato passa como sempre passou.
    function dentroDoHorario(sid) {
      let fim = dadosDaSessao(sid).get('horarioTermino', null);
      return !(fim is timestamp) || request.time <= fim + duration.value(5, 'm');
    }

    function podeVerSessao(sid) {
      return logado() && (souDono(sid) || entradaPaga(sid) || abandonada(dadosDaSessao(sid)));
    }

    function soMudou(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // A foto escolhida da galeria fica no proprio perfil, como JPEG pequeno
    // (192 px, uns 15 KB). O teto impede que alguem encha o documento — e,
    // copiada para presenca e pedidos, a fila inteira — com uma imagem enorme.
    function fotoCabe(d) {
      return !('photoURL' in d) || d.photoURL == null
             || (d.photoURL is string && d.photoURL.size() <= 100000);
    }

    match /cantores/{uid} {
      allow read:  if logado();
      allow create, update: if logado() && uid == eu() && fotoCabe(request.resource.data);
      allow delete: if logado() && uid == eu();
    }

    match /sessoes/{sid} {
      allow read:   if logado();
      // Sem exigir o carimbo: a versao instalada hoje (1.1.25) ainda nao
      // carimba, e ela precisa abrir a noite normalmente. Sessao sem dono fica
      // como sempre foi (qualquer Gerencia administra); com dono, so a dona.
      allow create: if logado() && (!('donoUid' in request.resource.data)
                                    || request.resource.data.donoUid == eu());
      // A dona manda; sessao abandonada ou antiga, qualquer Gerencia resolve; e
      // o cantor so consegue mandar o pedido de tocar (campo "comando").
      // Sessao abandonada ou antiga continua administravel por outra Gerencia
      // (encerrar, apagar), mas NINGUEM reescreve o dono: sem isto, dez minutos
      // sem sinal — KJ em modo offline, notebook dormindo — e qualquer pessoa
      // logada se carimbava dona da noite, liberava ingresso de graca, lia os
      // pagantes e trancava o KJ de verdade para fora.
      allow update: if logado() && (resource.data.donoUid == eu() || soMudou(['comando'])
                                    || ((abandonada(resource.data) || semDono(resource.data))
                                        && request.resource.data.get('donoUid', '') == resource.data.get('donoUid', '')));
      allow delete: if logado() && (resource.data.donoUid == eu() || abandonada(resource.data)
                                    || semDono(resource.data));

      match /fila/{itemId} {
        allow read:   if podeVerSessao(sid);
        // O cantor cria o proprio pedido; a Gerencia cria por qualquer um
        // (cantor adicionado a mao pelo KJ nao tem conta). Com entrada paga
        // ligada, o pedido do cantor so entra depois de o KJ confirmar o Pix.
        allow create: if logado() && (souDono(sid)
                                      || (request.resource.data.cantorUid == eu() && entradaPaga(sid)
                                          && dentroDoHorario(sid)));
        // O parceiro de dueto aceita o convite mexendo so nos campos do duo — e
        // tambem precisa de ingresso: sem isto, quem nao pagou aceitava um
        // convite (so com o id do pedido) e subia ao palco de graca.
        allow update: if logado() && (souDono(sid) || resource.data.cantorUid == eu()
                                      || (resource.data.duoUid == eu() && entradaPaga(sid)
                                          && soMudou(['duoPendente', 'duoNomeConfirmado', 'duoPhotoURL', 'duoUid', 'duoNome'])));
        allow delete: if logado() && (souDono(sid) || resource.data.cantorUid == eu());
      }

      // Marcar presenca nao exige ingresso: e assim que o KJ ve quem esta na
      // porta esperando (e pode liberar de cortesia). Ver as outras, exige.
      match /presencas/{uid} {
        allow read:  if podeVerSessao(sid) || (logado() && uid == eu());
        allow write: if logado() && (souDono(sid) || uid == eu());
      }

      // Quem desligou "aceitar convites para cantar" nao recebe convite nem
      // pedido de dueto (cantores/{uid}.aceitaDueto, ligado quando ausente).
      match /convites/{id} {
        allow read:   if podeVerSessao(sid);
        // Nasce sempre PENDENTE: deixar o proprio convidador escolher o status
        // era abrir conversa com quem nunca aceitou (o chat confia neste campo).
        // E so quem esta na noite convida.
        allow create: if logado() && (souDono(sid)
                                      || (request.resource.data.deUid == eu()
                                          && podeVerSessao(sid)
                                          && request.resource.data.status == 'pendente'
                                          && aceitaDueto(request.resource.data.paraUid)));
        // Quem responde e quem recebeu: so ele aceita, recusa ou diz que a
        // musica ja tem parceiro. Quem convidou so cancela e marca a resposta
        // como vista. Ninguem troca deUid/paraUid depois — trocar o paraUid
        // furava o "nao aceito convites" de quem tinha desligado.
        // A recusa guarda o NUMERO de uma das respostas prontas (chat.js), nunca
        // texto: senao recusar virava jeito de mandar qualquer coisa a quem
        // convidou, inclusive quem desligou as conversas.
        allow update: if logado() && (souDono(sid)
          || (resource.data.paraUid == eu()
              && soMudou(['status', 'resposta'])
              && request.resource.data.status in ['aceito', 'recusado', 'preenchido'])
          || (resource.data.deUid == eu()
              && (soMudou(['respostaVista'])
                  || (soMudou(['status']) && request.resource.data.status == 'cancelado')
                  // Convidar de novo a mesma musica (o app reusa o id do
                  // pedido), inclusive outra pessoa: o convite renasce
                  // PENDENTE. Convite ja aceito nao volta atras por aqui.
                  || (resource.data.status != 'aceito'
                      && request.resource.data.status == 'pendente'
                      && request.resource.data.deUid == eu()
                      && aceitaDueto(request.resource.data.paraUid)))))
          && (!('resposta' in request.resource.data)
              || (request.resource.data.resposta is int
                  && request.resource.data.resposta >= 0
                  && request.resource.data.resposta <= 4));
        allow delete: if logado() && (souDono(sid) || resource.data.paraUid == eu()
                                      || resource.data.deUid == eu());
      }

      // Conversa do dueto. So os dois leem; nem a Gerencia. O id e o do
      // convite, e ela so nasce de convite ACEITO entre duas pessoas que nao
      // desligaram as conversas. Limites iguais aos de chat.js.
      match /chats/{chatId} {
        function convite() {
          return get(/databases/$(database)/documents/sessoes/$(sid)/convites/$(chatId)).data;
        }
        function aceitaConversa(uid) {
          return get(/databases/$(database)/documents/cantores/$(uid)).data.get('aceitaChat', true) != false;
        }
        function participo() { return eu() in resource.data.participantes; }
        function mensagemBoa(m) {
          return m.keys().hasOnly(['deUid', 'deNome', 'texto', 'em'])
              && m.deUid == eu()
              && m.texto is string && m.texto.size() > 0 && m.texto.size() <= 500
              && m.deNome is string && m.deNome.size() <= 60
              && m.em is int;
        }

        allow read: if logado() && participo() && podeVerSessao(sid);

        allow create: if logado()
          && podeVerSessao(sid)
          && aceitaDueto(convite().paraUid)
          && request.resource.data.nomes.keys().hasOnly([convite().deUid, convite().paraUid])
          && convite().status == 'aceito'
          && eu() in [convite().deUid, convite().paraUid]
          && request.resource.data.participantes.size() == 2
          && request.resource.data.participantes.hasAll([convite().deUid, convite().paraUid])
          && request.resource.data.status == 'aberto'
          && request.resource.data.mensagens.size() == 0
          && aceitaConversa(convite().deUid) && aceitaConversa(convite().paraUid);

        allow update: if logado() && participo() && (
          // uma mensagem nova, no fim, sem mexer nas anteriores: todas as antigas
          // continuam la, ha exatamente uma a mais, e a ultima e a nova (nao e
          // nenhuma das antigas) — so ela e conferida, e tem que ser minha.
          // (Recortar a lista com [0:n] foi a primeira ideia; o banco recusava
          // ate a primeira mensagem de uma conversa vazia.)
          (soMudou(['mensagens'])
            && resource.data.status == 'aberto'
            && request.resource.data.mensagens.size() == resource.data.mensagens.size() + 1
            && request.resource.data.mensagens.size() <= 200
            && request.resource.data.mensagens.hasAll(resource.data.mensagens)
            && !(request.resource.data.mensagens[resource.data.mensagens.size()] in resource.data.mensagens)
            && mensagemBoa(request.resource.data.mensagens[resource.data.mensagens.size()]))
          // marcar ate onde eu li — so a minha marca
          || (soMudou(['vistoEm'])
            && request.resource.data.vistoEm.diff(resource.data.vistoEm).affectedKeys().hasOnly([eu()]))
          // encerrar: qualquer um dos dois, e nao reabre
          || (soMudou(['status', 'fechadoPor'])
            && request.resource.data.status == 'fechado'
            && request.resource.data.fechadoPor == eu())
        );

        // Morre com a noite: a faxina apaga sem ler (pelo id do convite). Vale
        // tambem para a sessao abandonada, derrubada de outra maquina: conversa
        // particular nao pode sobrar no banco porque a dona sumiu.
        allow delete: if logado() && (souDono(sid) || abandonada(dadosDaSessao(sid))
                                      || semDono(dadosDaSessao(sid)));
      }

      // Ponte de busca: o cantor grava o termo, a Gerencia devolve os candidatos.
      match /buscas/{id} {
        allow read:   if podeVerSessao(sid);
        allow create: if podeVerSessao(sid);
        allow update, delete: if souDono(sid);
      }

      // Entrada paga. O cantor avisa que pagou (status "aguardando") e pode
      // avisar de novo depois de um "nao-caiu"; so a Gerencia dona confirma. O
      // cantor nao le o pagamento dos outros.
      match /pagamentos/{uid} {
        function avisoBom(d) {
          return d.keys().hasOnly(['status', 'nomeArtistico', 'nomePagador', 'valor', 'avisadoEm'])
              && d.status == 'aguardando'
              && d.nomeArtistico is string && d.nomeArtistico.size() <= 60
              && d.nomePagador is string && d.nomePagador.size() > 0 && d.nomePagador.size() <= 80
              && d.valor == dadosDaSessao(sid).cobranca.valor
              && d.avisadoEm == request.time;
        }
        allow read:   if logado() && (uid == eu() || souDono(sid));
        allow create: if logado() && (souDono(sid) || (uid == eu() && avisoBom(request.resource.data)));
        allow update: if logado() && (souDono(sid)
                                      || (uid == eu() && resource.data.status == 'nao-caiu'
                                          && avisoBom(request.resource.data)));
        allow delete: if logado() && (souDono(sid) || abandonada(dadosDaSessao(sid))
                                      || semDono(dadosDaSessao(sid)));
      }

      // O QR e o copia-e-cola do ingresso. Ficavam no documento da sessao, que
      // qualquer pessoa logada consegue LISTAR: dava para varrer o banco e
      // colher a chave Pix (as vezes um CPF) e o nome de todas as casas. Agora
      // so ve quem esta na porta — quem marcou presenca — ou a Gerencia dona.
      match /cobranca/{doc} {
        allow read:  if logado() && (souDono(sid)
                                     || exists(/databases/$(database)/documents/sessoes/$(sid)/presencas/$(eu())));
        allow write: if souDono(sid);
      }

      match /historico/{id} { allow read: if podeVerSessao(sid); allow write: if souDono(sid); }
      match /meta/{doc}     { allow read: if podeVerSessao(sid); allow write: if souDono(sid); }
    }

    // Resumo permanente de cada noite, gravado pela Gerencia dona antes de a
    // faxina apagar a sessao (por isso a sessao ainda existe neste momento).
    match /relatorios/{sid} {
      allow read: if logado();
      allow create, update: if souDono(sid);
      allow delete: if false;
    }

    // Historico pessoal do cantor: ele le o dele; quem grava e a Gerencia dona
    // da sessao onde a musica foi cantada.
    match /historico/{uid}/apresentacoes/{id} {
      allow read, delete: if logado() && uid == eu();
      allow create, update: if logado() && (uid == eu() || souDono(request.resource.data.sessaoId));
    }

    // Acervo publicado pela Gerencia e cache de fotos de artista que o proprio
    // app do cantor preenche. Sao dados que o app reescreve sozinho: estragar
    // aqui nao derruba a noite de ninguem.
    match /catalogo/{itemId}    { allow read, write: if logado(); }
    match /artistas/{slug}      { allow read, write: if logado(); }
    match /configuracoes/{doc}  { allow read: if logado(); allow write: if false; }
  }
}
