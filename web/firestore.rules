rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Antes /sessoes, /catalogo, /configuracoes e /artistas eram "if true":
    // qualquer pessoa com o id do projeto conseguia ler e apagar a base inteira
    // sem autenticar. Agora nada e acessivel sem login.
    function logado() { return request.auth != null; }

    match /cantores/{uid} {
      allow read:  if logado();
      allow write: if logado() && request.auth.uid == uid;
    }

    match /sessoes/{sessaoId} {
      allow read, write: if logado();

      match /fila/{itemId} {
        allow read, write: if logado();
      }
      match /presencas/{uid} {
        allow read, write: if logado();
      }
      match /convites/{id} {
        allow read, write: if logado();
      }
      match /historico/{id} {
        allow read, write: if logado();
      }
      // Ponte de busca: o cantor grava o termo, o host devolve os candidatos.
      // Sem esta regra a escrita e negada com 403 e a busca nunca sai do lugar.
      match /buscas/{id} {
        allow read, write: if logado();
      }
      match /meta/{doc} {
        allow read, write: if logado();
      }
    }

    match /historico/{uid}/apresentacoes/{id} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    match /catalogo/{itemId} {
      allow read, write: if logado();
    }
    match /configuracoes/{doc} {
      allow read, write: if logado();
    }
    match /artistas/{slug} {
      allow read, write: if logado();
    }
  }
}
