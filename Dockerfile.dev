# ============================================================
# Voxly - Development Dockerfile for Electron
# ============================================================

FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    gtk+3.0 \
    nss \
    dbus \
    libnotify \
    xdg-utils

COPY app/package*.json ./
RUN npm install

COPY app/ ./

CMD ["npm", "run", "dev"]
